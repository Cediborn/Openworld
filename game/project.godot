; Engine configuration file.

config_version=5

[application]

config/name="Openworld"
config/description="Realistic open world exploration game. PC and landscape phone."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
scaling_3d/scale.mobile=0.62
environment/defaults/default_clear_color=Color(0.5, 0.65, 0.85, 1)
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
mesh_lod/lod_change/threshold_pixels=1.5
